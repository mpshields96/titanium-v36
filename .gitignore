# Never commit secrets
.streamlit/secrets.toml

# Python
__pycache__/
*.py[cod]
*.pyo
.env

# macOS
.DS_Store

# SQLite databases (v36 uses Supabase — no local .db files should be committed)
*.db
*.db-wal
*.db-shm

# API quota daily log — runtime state, not source code
daily_quota.json

# Activity tracking — runtime state, never commit
data/last_activity.json

# Claude Code internals — never commit these
.claude/
.playwright-mcp/
*.png
CLAUDE.local.md
